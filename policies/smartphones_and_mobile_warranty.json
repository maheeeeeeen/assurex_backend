{
  "policy_id": "POL-MOBILE-001",
  "policy_name": "Flagship Mobile Devices & Tablets Warranty",
  "product_category": "Smartphones & Mobile",
  "coverage_duration_months": 24,
  "warranty_start_condition": "purchase_date",
  "covered_faults": [
    "Manufacturing Defect",
    "OLED Display Flickering",
    "Cellular Modem Signal Drop",
    "Microphone Component Failure",
    "Battery Premature Swelling",
    "Motherboard Power Controller Crash",
    "Biometric Sensor Failure"
  ],
  "exclusions": [
    "Shattered Screen from Drop",
    "Submersion Water Damage",
    "Unauthorized Screen Replacement",
    "Jailbreak or Unofficial ROM Brick",
    "Cracked Rear Glass Chassis",
    "Third-Party Charger Damage"
  ],
  "claim_reporting_period_days": 21,
  "max_repairs_before_replacement": 2,
  "authorized_service_required": true,
  "mandatory_documents": [
    "purchase_receipt",
    "fault_evidence",
    "product_image"
  ],
  "optional_documents": [
    "warranty_card",
    "repair_report",
    "imei_number_photo"
  ],
  "hard_fail_rules": [
    {
      "rule_id": "HF-001",
      "description": "Warranty period has expired",
      "condition": "warranty_expired",
      "action": "reject"
    },
    {
      "rule_id": "HF-002",
      "description": "Damage type is in mobile exclusion list (e.g. liquid ingress, cracked glass)",
      "condition": "excluded_damage",
      "action": "reject"
    },
    {
      "rule_id": "HF-003",
      "description": "No proof of purchase receipt provided",
      "condition": "no_purchase_receipt",
      "action": "reject"
    },
    {
      "rule_id": "HF-004",
      "description": "Unauthorized hardware modification or non-genuine display detected",
      "condition": "unauthorized_hardware_tamper",
      "action": "reject"
    }
  ],
  "warning_rules": [
    {
      "rule_id": "WR-001",
      "description": "IMEI / Serial number does not match purchase receipt",
      "condition": "serial_mismatch",
      "action": "flag"
    },
    {
      "rule_id": "WR-002",
      "description": "Battery health degradation warning",
      "condition": "battery_cycle_warning",
      "action": "flag"
    },
    {
      "rule_id": "WR-003",
      "description": "Device has had multiple prior screen or battery repairs",
      "condition": "high_repair_count",
      "threshold": 2,
      "action": "flag"
    }
  ],
  "manual_review_rules": [
    {
      "rule_id": "MR-001",
      "description": "Warranty expiry within 7-day grace period",
      "condition": "borderline_warranty",
      "action": "manual_review"
    },
    {
      "rule_id": "MR-002",
      "description": "Contradictory dates detected in mobile claim submission",
      "condition": "contradictory_dates",
      "action": "manual_review"
    },
    {
      "rule_id": "MR-003",
      "description": "Repair performed by third-party uncertified mobile repair shop",
      "condition": "unauthorized_repair",
      "action": "manual_review"
    }
  ],
  "grace_period_days": 7,
  "replacement_conditions": {
    "min_repairs_for_replacement": 2,
    "max_product_age_months": 24
  }
}
