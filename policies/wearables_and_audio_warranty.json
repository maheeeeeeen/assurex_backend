{
  "policy_id": "POL-WEARABLES-001",
  "policy_name": "Wearable Tech & Personal Audio Limited Warranty",
  "product_category": "Wearables & Audio",
  "coverage_duration_months": 12,
  "warranty_start_condition": "purchase_date",
  "covered_faults": [
    "Manufacturing Defect",
    "Driver Voice Coil Failure",
    "Bluetooth Radio Intermittent Sync",
    "Heart Rate Sensor Inaccuracy",
    "Charging Pin Contact Failure",
    "Active Noise Cancellation Distortion",
    "Haptic Vibration Motor Defect"
  ],
  "exclusions": [
    "Crushed Ear-Cup Impact",
    "Saltwater Corrosion",
    "Torn Headband Fabric",
    "Cable Snag Damage",
    "Dog Chew Damage",
    "Sweat Ingress Beyond IP Rating"
  ],
  "claim_reporting_period_days": 14,
  "max_repairs_before_replacement": 2,
  "authorized_service_required": true,
  "mandatory_documents": [
    "purchase_receipt",
    "fault_evidence"
  ],
  "optional_documents": [
    "warranty_card",
    "product_image",
    "serial_number_photo"
  ],
  "hard_fail_rules": [
    {
      "rule_id": "HF-001",
      "description": "Warranty period has expired",
      "condition": "warranty_expired",
      "action": "reject"
    },
    {
      "rule_id": "HF-002",
      "description": "Physical crushing or foreign substance ingress detected",
      "condition": "excluded_damage",
      "action": "reject"
    },
    {
      "rule_id": "HF-003",
      "description": "Proof of purchase missing from claim dossier",
      "condition": "no_purchase_receipt",
      "action": "reject"
    }
  ],
  "warning_rules": [
    {
      "rule_id": "WR-001",
      "description": "Charging case serial does not match earbud serial registration",
      "condition": "serial_mismatch",
      "action": "flag"
    },
    {
      "rule_id": "WR-002",
      "description": "Noticeable cosmetic abrasions reported with audio defect",
      "condition": "cosmetic_wear_flag",
      "action": "flag"
    }
  ],
  "manual_review_rules": [
    {
      "rule_id": "MR-001",
      "description": "Fault reported within 5-day post-warranty grace period",
      "condition": "borderline_warranty",
      "action": "manual_review"
    },
    {
      "rule_id": "MR-002",
      "description": "Contradictory dates in claim manifest",
      "condition": "contradictory_dates",
      "action": "manual_review"
    },
    {
      "rule_id": "MR-003",
      "description": "Prior repair or battery replacement by unauthorized third party",
      "condition": "unauthorized_repair",
      "action": "manual_review"
    }
  ],
  "grace_period_days": 5,
  "replacement_conditions": {
    "min_repairs_for_replacement": 2,
    "max_product_age_months": 12
  }
}
